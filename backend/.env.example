# Copy to backend/.env for local dev. Never commit .env.
# Unset DATABASE_URL = local SQLite (./conan.db). Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10
GEMINI_CONCURRENCY=2
BATCH_CHARS=8000
PIPELINE_VERSION=v1
PROMPT_VERSION=p1
LLM_MODE=live
ALLOWED_ORIGINS=http://localhost:5173
# DEMO_AS_OF=2026-10-28
