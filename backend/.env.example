# Copy to backend/.env for local dev. Never commit .env.
# Unset DATABASE_URL = local SQLite (./conan.db). Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
GEMINI_API_KEY=
# Optional: more keys, comma-separated. They share the load and fail over on quota.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary is overloaded (503), slow, or retired (404).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash
GEMINI_RPM=10
GEMINI_CONCURRENCY=2
BATCH_CHARS=8000
PIPELINE_VERSION=v1
PROMPT_VERSION=p1
LLM_MODE=live
ALLOWED_ORIGINS=http://localhost:5173
# Optional regex (full match) for extra origins, e.g. Vercel deployment URLs:
# ALLOWED_ORIGIN_REGEX=https://conan-[a-z0-9]+-codedsuperhero\.vercel\.app
# Stretch: one real "Send test reminder" email via Resend (free tier: only to your Resend account address
# until you verify a sending domain).
ENABLE_REMINDERS=false
RESEND_API_KEY=
# REMINDER_FROM=Conan <onboarding@resend.dev>
# DEMO_AS_OF=2026-10-28
